<launch>

    <!-- 启动一个空的Gazebo世界，并设置一些参数 -->
    <!-- <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="false"/>
        <arg name="gui" value="true"/>
        <arg name="verbose" value="false"/>
        <arg name="debug" value="false"/>
    </include> -->

    <!-- gazebo机器人初始位姿 -->
    <node name="spawn_model" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -file $(find robot)/urdf/robot.urdf -model robot 
                -x 0 -y 0 -z 0.2
                -R 0 -P 0 -Y 0.0"
        output="screen" />

    <!-- 串口通信节点 -->
    <node pkg="serial_com" type="serial_com" name="serial_com" output="screen">
        <!-- 参数设置 /dev/ttyACM0  /dev/pts/4-->
        <param name="cmd_vel_topic" type="string" value="/cmd_vel1" />
        <param name="serial_port" type="string" value="/dev/ttyACM0" />
        
        <!-- ROS参数服务器设置 -->
        <rosparam>
            baud_rate: 115200
            timeout: 1000
            default_spin_mode: false
        </rosparam>
    </node>

     <!-- 启动键盘控制节点，将cmd_vel话题重映射到/cmd_vel1 -->
    <node name="teleop_keyboard" pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" 
          output="screen" respawn="false">
        <remap from="cmd_vel" to="/cmd_vel1"/>
    </node>

</launch>
