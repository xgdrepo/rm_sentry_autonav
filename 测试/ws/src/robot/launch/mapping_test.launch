<?xml version="1.0"?>
<launch>
    <!-- <param name="/use_sim_time" value="true" /> -->

    <!-- rviz显示 -->
    <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find robot)/rviz/config.rviz" /> -->

    <!-- base_link和lidar_link坐标变换 -->
    <node name="tf_base_lidar" pkg="tf" type="static_transform_publisher"
          args="-0.046164 -0.20002 0.16926  0 3.1415 0 /base_link /lidar_link 40" />

    <!-- <node name="tf_base_odom" pkg="tf" type="static_transform_publisher"
          args="0 0 0 0 0 0 /odom /base_link 40" /> -->

    <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch">
    </include>

    <!-- 三维点云 转 二维点云  -->
    <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan">
        <remap from="cloud_in" to="/livox/lidar"/>
        <remap from="scan" to="/scan"/>
        <rosparam>
            target_frame: lidar_link
            transform_tolerance: 0.001
            min_height: -1
            max_height: 0.3
            angle_min: -3.1415926
            angle_max: 3.1415926
            angle_increment: 0.005
            scan_time: 0.01
            range_min: 0.4
            range_max: 20
            use_inf: true
            concurrency_level: 1
        </rosparam>
    </node>

  #### start the laser scan_matcher ##############################

  <node pkg="laser_scan_matcher" type="laser_scan_matcher_node" 
    name="laser_scan_matcher_node" output="screen">

    <param name="fixed_frame" value = "odom"/>
    <param name="max_iterations" value="10"/>

    <param name="base_frame" value = "base_link"/>
    <param name="use_odom" value="false"/>
    <param name="publy_pose" value = "true"/>
    <param name="publy_tf" value="true"/>


  </node>

  #### start gmapping ############################################

    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping">
      <!-- 激光范围设置 -->
      <param name="maxRange" value="50.0"/>
      <param name="maxUrange" value="49.0"/>
      
      <!-- 高分辨率激光优化参数 -->
      <param name="lstep" value="0.01"/>
      <param name="astep" value="0.02"/>
      <param name="iterations" value="3"/>
      <param name="kernelSize" value="1"/>
      <param name="sigma" value="0.05"/>
      
      <!-- 降低计算负载 -->
      <param name="lskip" value="1"/>  <!-- 非常重要！从2094点降到约349点 -->
      <param name="particles" value="30"/>
      <param name="minimumScore" value="0.0"/>  <!-- 避免大空间中的跳变 -->
      <param name="occ_thresh " value="0"/>
      
      <!-- 更新频率控制 -->
      <param name="linearUpdate" value="-1"/>   <!-- 每移动0.5米更新（默认1.0） -->
      <param name="angularUpdate" value="-1"/>  <!-- 每旋转0.3弧度更新（默认0.5） -->
      <param name="temporalUpdate" value="0.01"/> <!-- 时间更新间隔 -->
      
      <!-- 地图参数 -->
      <param name="delta" value="0.05"/>
      <param name="xmin" value="-50"/>
      <param name="ymin" value="-50"/>
      <param name="xmax" value="50"/>
      <param name="ymax" value="50"/>
      
      <!-- 框架设置 -->
      <param name="base_frame" value="base_link"/>
      <param name="odom_frame" value="odom"/>
      <param name="map_frame" value="map"/>
      
      <remap from="scan" to="/scan"/>
  </node>




</launch>
